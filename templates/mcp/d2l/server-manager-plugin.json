{
  "id": "d2l-mcp",
  "name": "Waterloo LEARN (D2L)",
  "description": "Waterloo LEARN course data, assignments, grades MCP",
  "version": "1.0.0",
  "type": "mcp-stdio",
  "entry": "server.mjs",
  "install": "npm install",
  "env": [
    {
      "key": "WATERLOO_USERNAME",
      "label": "WatIAM Username",
      "description": "Your 8-character Quest/LEARN username",
      "required": false,
      "secret": false
    },
    {
      "key": "WATERLOO_PASSWORD",
      "label": "WatIAM Password",
      "description": "Used for automated Duo login",
      "required": false,
      "secret": true
    },
    {
      "key": "d2lSessionVal",
      "label": "D2L Session Cookie",
      "description": "Active session cookie from browser if not using password",
      "required": false,
      "secret": true
    },
    {
      "key": "d2lSecureSessionVal",
      "label": "D2L Secure Session Cookie",
      "description": "Active secure session cookie",
      "required": false,
      "secret": true
    },
    {
      "key": "LEARN_ICAL_URL",
      "label": "LEARN Calendar Feed URL",
      "description": "Personal iCal subscription URL from LEARN, used for due dates",
      "required": false,
      "secret": true
    },
    {
      "key": "NTFY_TOPIC",
      "label": "ntfy Topic",
      "description": "Optional ntfy topic for assignment notifications",
      "required": false,
      "secret": false
    }
  ],
  "tags": ["d2l", "learn", "university", "courses"],
  "claude_config": {
    "command": "node",
    "args": ["server.mjs"]
  }
}
