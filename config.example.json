{
  "hostname": "myserver",
  "port": 18080,
  "services": [
    {
      "name": "Paseo Agent Daemon",
      "unit": "paseo.service",
      "type": "user",
      "port": 6767,
      "web": false
    },
    {
      "name": "9Router LLM Gateway",
      "unit": "9router.service",
      "type": "user",
      "port": 20128,
      "web": true
    }
  ],
  "deps": {
    "node": {
      "check": "node -v",
      "fix": null,
      "install": "curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - && sudo apt-get install -y nodejs"
    },
    "tailscale": {
      "check": "tailscale status --json",
      "fix": "sudo systemctl start tailscaled",
      "install": "curl -fsSL https://tailscale.com/install.sh | sh"
    },
    "9router": {
      "check": "which 9router",
      "fix": "systemctl --user start 9router.service",
      "install": "npm install -g 9router"
    },
    "paseo": {
      "check": "which paseo",
      "fix": "systemctl --user start paseo.service",
      "install": "npm install -g @getpaseo/cli"
    }
  },
  "plugins": {}
}
