{
  "hostname": "myserver",
  "port": 18080,
  "services": [
    {
      "name": "Paseo Agent Daemon",
      "unit": "paseo.service",
      "type": "user",
      "port": 6767,
      "web": false
    },
    {
      "name": "9Router LLM Gateway",
      "unit": "9router.service",
      "type": "user",
      "port": 20128,
      "web": true
    },
    {
      "name": "9Router Smart Router",
      "unit": "9router-smart-router.service",
      "type": "user",
      "port": 20129,
      "web": false
    },
    {
      "name": "Headroom Proxy",
      "unit": "headroom.service",
      "type": "user",
      "port": 8787,
      "web": false
    },
    {
      "name": "Time Study",
      "unit": "time-study.service",
      "type": "user",
      "port": 3456,
      "web": true
    }
  ],
  "deps": {
    "tailscale": { "check": "tailscale status --json", "fix": null },
    "9router": { "check": "systemctl --user is-active 9router.service", "fix": "systemctl --user start 9router.service" },
    "paseo": { "check": "systemctl --user is-active paseo.service", "fix": "systemctl --user start paseo.service" }
  },
  "plugins": {}
}
