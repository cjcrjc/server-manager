[Unit]
Description=Server Manager Dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/server-manager
Environment="PATH=%h/.local/bin:%h/.local/opt/node-v24.21.0-linux-x64/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/opt/node-v24.21.0-linux-x64/bin/node server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
